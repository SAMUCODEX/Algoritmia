Algoritmo PromedioNotas
	Definir nota1, nota2, nota3, nota4, nota5, promedio Como Real
	Escribir 'Ingrese su nota 1: '
	Leer nota1
	Escribir 'Ingrese su nota 2: '
	Leer nota2
	Escribir 'Ingrese su nota 3: '
	Leer nota3
	Escribir 'Ingrese su nota 4: '
	Leer nota4
	Escribir 'Ingrese su nota 5: '
	Leer nota5
	promedio <- (nota1+nota2+nota3+nota4+nota5)/5
	Escribir 'El promedio de sus notas es: ', promedio
FinAlgoritmo
